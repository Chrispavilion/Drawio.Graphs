<mxfile host="app.diagrams.net">
  <diagram id="grafana-arch" name="Architecture">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Grafana Dashboard as Code - Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="440" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="json" value="&lt;b&gt;Dashboard JSON&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;dashboard.json (panels, queries, layout)&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="maintf" value="&lt;b&gt;main.tf&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;file(&quot;dashboard.json&quot;) → config_json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="resource" value="&lt;b&gt;grafana_dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Terraform resource (Grafana provider)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="320" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Dashboard created / updated via HTTP API&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="260" y="450" width="280" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="provider" value="Provider config&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;url + auth token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="320" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="read" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="json" target="maintf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="defines" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="maintf" target="resource">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="terraform apply" style="endArrow=classic;html=1;strokeWidth=2;" edge="1" parent="1" source="resource" target="grafana">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="provider" target="resource">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
