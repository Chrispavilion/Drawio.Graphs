<mxCell id="notes" value="&lt;b&gt;Assumptions &amp;amp; unknowns&lt;/b&gt;&lt;br&gt;Counts come from active .tf files (comment lines excluded). Solid arrow = explicit reference/attribute in code; dashed = literal value or inferred behaviour. Dependencies not drawn are not expressed in code.&lt;br&gt;dashboards.tf passes literal folder_uid strings to 18 team modules; module.tap2play uses grafana_folder.tap2play.uid. Most rule groups and all folder permissions except &quot;sre&quot; use literal folder UIDs / team IDs (e.g. &quot;1:25&quot;), i.e. no Terraform dependency.&lt;br&gt;Outside the stack: x_archive/, backup-alerts/, grafana_scripts/. Contact-point targets (Opsgenie, Teams, email) and Grafana data sources are external; Terraform only references them by name/UID." style="html=1;whiteSpace=wrap;rounded=0;fontSize=9.5;fillColor=#fafafa;strokeColor=#9e9e9e;strokeWidth=1;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="20" y="1099" width="1614" height="62" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
<diagram id="page3" name="3 Providers vs backend">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;3 · Provider versus backend responsibilities&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#222222;strokeColor=none;fillColor=none;spacingLeft=2;spacingRight=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1129" height="28" as="geometry"/></mxCell>
<mxCell id="sub" value="The backend stores state. Providers create and read the resources declared in code. azurerm is used for the backend; its provider block manages nothing here." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;strokeColor=none;fillColor=none;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1129" height="20" as="geometry"/></mxCell>
<mxCell id="top" value="&lt;b&gt;config/terraform/backend.tf + provider.tf  (Terraspace merges them into the built Grafana-Prod stack)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;terraform { required_version = &quot;1.5.5&quot; · required_providers: azurerm &amp;gt;= 3.48, grafana &amp;gt;= 2.9.0 · backend &quot;azurerm&quot; { … } }&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=note;size=14;backgroundOutline=1;darkOpacity=0.05;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="68" width="1129" height="52" as="geometry"/></mxCell>
<mxCell id="ZL" value="&lt;b&gt;BACKEND — where Terraform keeps state&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=none;strokeColor=#777777;strokeWidth=1.2;fillColor=none;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="380" height="550" as="geometry"/></mxCell>
<mxCell id="ZR" value="&lt;b&gt;PROVIDERS — plugins that call APIs for resources declared in code&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=12;fillColor=none;strokeColor=#777777;strokeWidth=1.2;fillColor=none;dashed=1;dashPattern=6 4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="729" height="550" as="geometry"/></mxCell>
<mxCell id="t1" value="backend block" style="edgeStyle=none;html=1;rounded=0;endFill=1;startFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=9;fontColor=#333333;endArrow=block;startArrow=none;labelBackgroundColor=#ffffff;exitX=0.1682905225863596;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="top" target="ZL"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t2" value="provider blocks" style="edgeStyle=none;html=1;rounded=0;endFill=1;startFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=9;fontColor=#333333;endArrow=block;startArrow=none;labelBackgroundColor=#ffffff;exitX=0.6775907883082374;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="top" target="ZR"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cyl" value="&lt;b&gt;backend &quot;azurerm&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;container: grafana-prod&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;blob key: terraform.tfstate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;storage account: stterraformprodeus2001&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;resource group: rsg-terraform-prod-azeus2-001&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="300" height="150" as="geometry"/></mxCell>
<mxCell id="blob" value="&lt;b&gt;Azure Blob Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;holds terraform.tfstate&lt;/font&gt;" style="html=1;whiteSpace=wrap;ellipse;shape=cloud;fontSize=11;fillColor=#f0f0f0;strokeColor=#666666;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="85" y="375" width="250" height="75" as="geometry"/></mxCell>
<mxCell id="b1" value="state read / write" style="edgeStyle=none;html=1;rounded=0;endFill=1;startFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=9;fontColor=#333333;endArrow=block;startArrow=none;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="cyl" target="blob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="resp" value="&lt;b&gt;Backend responsibilities&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;• Stores and retrieves terraform.tfstate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;• Is not a provider and creates no resources&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;• Storage account, resource group and container are&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;   not declared in this repo (assumed pre-existing)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;• Auth: ARM_* env vars exported by the pipelines&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;• State locking is azurerm backend behaviour&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=0;fontSize=11;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="340" height="140" as="geometry"/></mxCell>
<mxCell id="obs" value="&lt;b&gt;Observation (verify)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Backend key is a fixed &quot;terraform.tfstate&quot;; another key is&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;commented out. Fine for one stack in one container.&lt;/font&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fontSize=11;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="340" height="65" as="geometry"/></mxCell>
<mxCell id="h0" value="&lt;b&gt;grafana.cloud&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;alias &quot;cloud&quot;&lt;/font&gt;" style="html=1;whiteSpace=wrap;shape=hexagon;perimeter=hexagonPerimeter2;size=0.09;fontSize=12;fillColor=#fff2cc;strokeColor=#b8860b;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="219" width="200" height="64" as="geometry"/></mxCell>
<mxCell id="r0" value="Configured with: cloud_access_policy_token (literal string in provider.tf)&lt;br&gt;Calls: Grafana Cloud API (default endpoint, not set in code)&lt;br&gt;Manages 3 resources (cloud-stack.tf, Service-accounts.tf):&lt;br&gt;   grafana_cloud_stack.pavilionpay  (prevent_destroy = true)&lt;br&gt;   grafana_cloud_stack_service_account.cloud_sa&lt;br&gt;   grafana_cloud_stack_service_account_token.cloud_sa" style="html=1;whiteSpace=wrap;rounded=0;fontSize=10.5;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="665" y="195" width="470" height="112" as="geometry"/></mxCell>
